<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow ALL cleartext traffic in DEBUG for Maestro E2E driver (port 7001) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
