<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- SECURITY: Hardened base config prohibiting all cleartext traffic. Previous exceptions for ip-api.com are removed. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>


