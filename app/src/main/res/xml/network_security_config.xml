<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Security Hardening: Prohibit cleartext HTTP traffic across all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>


