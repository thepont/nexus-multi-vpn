<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Network Security Configuration for Multi-Region VPN.

      SECURITY HARDENING:
      - All cleartext (HTTP) traffic is strictly prohibited.
      - System trust anchors only.
      - Removed previous exception for insecure ip-api.com.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
