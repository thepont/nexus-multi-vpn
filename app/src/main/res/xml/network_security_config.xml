<?xml version="1.0" encoding="utf-8"?>
<!-- Security Hardening: Prohibit cleartext traffic for all domains in production -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
