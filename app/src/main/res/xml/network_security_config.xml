<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      SECURITY HARDENING: Prohibit cleartext traffic for production.
      All GeoIP lookups now use HTTPS via freeipapi.com.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
