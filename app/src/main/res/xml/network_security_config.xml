<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Security Hardening:
      Prohibit all cleartext traffic across all domains. All HTTP requests are blocked
      by default to prevent eavesdropping and data tampering.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>


