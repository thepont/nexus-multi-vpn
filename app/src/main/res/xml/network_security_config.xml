<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Production Hardening:
      All cleartext traffic is explicitly denied.
      GeoIpService and test utilities must use HTTPS (e.g., https://ipwho.is).
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
